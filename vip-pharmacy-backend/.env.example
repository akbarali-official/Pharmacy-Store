# Is file ko copy karke ".env" naam se banayein aur values bharein. KABHI .env share/commit na karein.
DATABASE_URL="postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/vip_pharmacy?schema=public"
# Kam az kam 32 random characters. Production mein har customer ke liye alag rakhein.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN"
PORT=4000
# Frontend ka address (kai ho to comma se alag karein)
CORS_ORIGIN="http://localhost:5173"
